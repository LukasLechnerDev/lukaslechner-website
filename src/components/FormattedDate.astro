---
interface Props {
  date: Date;
}
const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
  {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
</time>

<style>
  time {
    font-size: 0.85rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
</style>
