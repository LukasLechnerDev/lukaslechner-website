---
import CourseCard from './CourseCard.astro';
import image from '../assets/blog/2026-07-udemy-course-icon-centered.png';
import { AI_COURSE_URL } from '../consts';
---

<CourseCard eyebrow="New course" title="AI Engineering Fundamentals" href={AI_COURSE_URL} image={image}>
  <p>
    Become a job-ready AI engineer with the OpenAI API, prompt engineering, structured outputs and
    real portfolio projects. 7+ hours and 50+ videos, with new modules added for free as they're
    released.
  </p>
</CourseCard>
