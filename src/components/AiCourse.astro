---
import CourseCard from './CourseCard.astro';
import image from '../assets/blog/2026-07-udemy-course-icon-centered.png';
import { AI_COURSE_URL } from '../consts';
---

<CourseCard eyebrow="New course" title="AI Engineering Fundamentals" href={AI_COURSE_URL} image={image}>
  <p>
    Build real LLM applications in Python and learn what it takes to bring them to production:
    choosing models, managing context and cost, evals, RAG, LangChain and LangGraph. 7+ hours and
    50+ videos, with new modules added for free as they're released.
  </p>
</CourseCard>
