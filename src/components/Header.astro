---
import { ACADEMY_URL, url } from '../consts';

const links = [
  { href: 'blog/', label: 'Blog' },
  { href: 'course/', label: 'Courses' },
  { href: 'talks/', label: 'Talks', hideOnPhone: true },
  { href: 'about/', label: 'About', hideOnPhone: true },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={url()}>
      Lukas Lechner
    </a>
    <nav aria-label="Main">
      {
        links.map((l) => (
          <a href={url(l.href)} class:list={{ 'hide-phone': l.hideOnPhone }} aria-current={path.startsWith(url(l.href)) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
      <a class="academy" href={ACADEMY_URL}>Academy<span class="ext"> ↗</span></a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: saturate(160%) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4rem;
  }
  .brand {
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }
  nav {
    display: flex;
    gap: 0.25rem;
    overflow-x: auto;
  }
  nav a {
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
  }
  nav a:hover {
    color: var(--text);
    background: var(--surface);
  }
  nav a.academy {
    margin-left: 0.4rem;
    color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
    white-space: nowrap;
  }
  nav a.academy:hover {
    color: var(--accent-text);
    background: var(--accent);
  }
  nav a[aria-current='page'] {
    color: var(--text);
    background: var(--surface);
  }
  @media (max-width: 560px) {
    .brand {
      font-size: 0.95rem;
    }
    nav {
      gap: 0;
    }
    nav a {
      padding: 0.35rem 0.45rem;
      font-size: 0.875rem;
    }
    nav a.academy {
      margin-left: 0.25rem;
      padding: 0.35rem 0.6rem;
    }
    .ext {
      display: none;
    }
  }
  @media (max-width: 430px) {
    .hide-phone {
      display: none;
    }
  }
</style>
