---
import { ACADEMY_URL, url } from '../consts';

const links = [
  { href: 'blog/', label: 'Blog' },
  { href: 'course/', label: 'Courses' },
  { href: 'talks/', label: 'Talks', hideOnPhone: true },
  { href: 'about/', label: 'About' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={url()}>
      <svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M8 3h16a6 6 0 0 1 6 6v10a6 6 0 0 1-6 6H13l-6.5 5v-5.3A6 6 0 0 1 2 19V9a6 6 0 0 1 6-6Z" fill="#3f6b35" />
        <g fill="none" stroke="#f7faf3" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 8.5v10.5h5" />
          <path d="M18 8.5v10.5h5" />
        </g>
      </svg>
      <span class="name">Lukas Lechner</span>
    </a>
    <nav aria-label="Main">
      {
        links.map((l) => (
          <a href={url(l.href)} class:list={{ 'hide-phone': l.hideOnPhone }} aria-current={path.startsWith(url(l.href)) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
      <a class="academy" href={ACADEMY_URL}>Academy<span class="ext"> ↗</span></a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: saturate(160%) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }
  .mark {
    display: block;
    width: 2rem;
    height: 2rem;
    flex: none;
    transition: transform 0.2s ease;
  }
  .brand:hover .mark {
    transform: translateY(-2px);
  }
  nav {
    display: flex;
    gap: 0.25rem;
    overflow-x: auto;
  }
  nav a {
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
  }
  nav a:hover {
    color: var(--text);
    background: var(--surface);
  }
  nav a.academy {
    margin-left: 0.4rem;
    color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
    white-space: nowrap;
  }
  nav a.academy:hover {
    color: var(--accent-text);
    background: var(--accent);
  }
  nav a[aria-current='page'] {
    color: var(--text);
    background: var(--surface);
  }
  @media (max-width: 560px) {
    .name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    nav {
      gap: 0;
    }
    nav a {
      padding: 0.35rem 0.45rem;
      font-size: 0.875rem;
    }
    nav a.academy {
      margin-left: 0.25rem;
      padding: 0.35rem 0.6rem;
    }
    .ext {
      display: none;
    }
  }
  @media (max-width: 430px) {
    .hide-phone {
      display: none;
    }
  }
</style>
