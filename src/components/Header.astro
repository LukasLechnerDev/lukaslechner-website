---
import { url } from '../consts';

const links = [
  { href: 'blog/', label: 'Blog' },
  { href: 'course/', label: 'Courses' },
  { href: 'talks/', label: 'Talks' },
  { href: 'about/', label: 'About' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={url()}>
      <span class="mark" aria-hidden="true">LL</span>
      <span class="name">Lukas Lechner</span>
    </a>
    <nav aria-label="Main">
      {
        links.map((l) => (
          <a href={url(l.href)} aria-current={path.startsWith(url(l.href)) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: saturate(160%) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    background: var(--accent);
    color: var(--accent-text);
    font-size: 0.8rem;
    font-weight: 800;
  }
  nav {
    display: flex;
    gap: 0.25rem;
    overflow-x: auto;
  }
  nav a {
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
  }
  nav a:hover {
    color: var(--text);
    background: var(--surface);
  }
  nav a[aria-current='page'] {
    color: var(--text);
    background: var(--surface);
  }
  @media (max-width: 560px) {
    .name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    nav a {
      padding: 0.4rem 0.55rem;
      font-size: 0.9rem;
    }
  }
</style>
