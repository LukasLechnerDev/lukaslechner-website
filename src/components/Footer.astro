---
import { ACADEMY_URL, SOCIALS, url } from '../consts';
import { ICONS } from '../icons';

---

<footer class="site-footer">
  <div class="container inner">
    <div class="meta">
      <p>© {new Date().getFullYear()} Lukas Lechner · Vienna, Austria</p>
      <p class="text-links">
        <a href={ACADEMY_URL}>Pragmatic AI Academy</a>
        <a href={url('about/')}>About</a>
        <a href={url('talks/')}>Talks</a>
      </p>
    </div>
    <ul class="socials">
      {
        SOCIALS.map((s) => (
          <li>
            <a href={s.href} rel="me noopener" aria-label={s.label} title={s.label}>
              <svg viewBox="0 0 24 24" aria-hidden="true" fill-rule="evenodd">
                <path d={ICONS[s.icon]} />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding-top: 2rem;
    padding-bottom: 2.5rem;
  }
  p {
    margin: 0;
  }
  .text-links {
    display: flex;
    gap: 1.1rem;
    margin-top: 0.25rem;
  }
  .text-links a {
    color: var(--muted);
    text-decoration: none;
  }
  .text-links a:hover {
    color: var(--accent);
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0 -0.65rem;
    padding: 0;
  }
  .socials a {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    color: var(--muted);
    transition:
      color 0.15s ease,
      background 0.15s ease;
  }
  .socials a:hover {
    color: var(--accent);
    background: var(--accent-soft);
  }
  svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: currentColor;
  }
</style>
