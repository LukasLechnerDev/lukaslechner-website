---
import Base from '../layouts/Base.astro';
import AiCourse from '../components/AiCourse.astro';
import CoroutinesCourse from '../components/CoroutinesCourse.astro';
import { AI_COURSE_URL } from '../consts';

const topics = [
  ['The OpenAI API', 'Working with LLMs from Python, the foundation everything else builds on'],
  ['Prompt engineering', 'Getting reliable results out of a model instead of lucky one-offs'],
  ['Structured outputs', 'Making model responses predictable enough for real applications'],
  ['Portfolio projects', 'Real projects you can show when applying for AI engineering roles'],
];
---

<Base title="Courses" description="AI Engineering Fundamentals: build real LLM apps in Python with the OpenAI API. Plus Kotlin Coroutines and Flow for Android.">
  <div class="container page">
    <AiCourse />

    <section class="topics">
      <h2>What you'll learn</h2>
      <p class="intro">
        The fundamentals that take you from Python developer to job-ready AI engineer:
      </p>
      <ul>
        {
          topics.map(([title, text]) => (
            <li>
              <h3>{title}</h3>
              <p>{text}</p>
            </li>
          ))
        }
      </ul>
      <a class="button" href={AI_COURSE_URL}>Enroll on Udemy →</a>
    </section>

    <section class="more">
      <h2>For Android developers</h2>
      <CoroutinesCourse />
    </section>
  </div>
</Base>

<style>
  .page {
    padding-top: 3rem;
  }
  .topics,
  .more {
    margin-top: 4rem;
  }
  h2 {
    font-size: 1.6rem;
    margin: 0 0 0.5rem;
  }
  .more h2 {
    margin-bottom: 1.5rem;
  }
  .intro {
    color: var(--muted);
    margin: 0 0 1.5rem;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1rem;
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
  }
  li {
    padding: 1.25rem 1.4rem;
    border: 1px solid var(--border);
    border-radius: 14px;
  }
  h3 {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
  }
  li p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }
</style>
